{
  // This file is used by VS Code's "Dev Containers: Reopen in Container"
  // flow, NOT by "Attach to Running Container". The container in this project
  // is launched externally by ./run_docker.py, so the attach flow is what
  // most users actually use -- and that flow reads its config from
  //   <vscode-user-data>/User/globalStorage/
  //       ms-vscode-remote.remote-containers/nameConfigs/<container>.json
  // not from this file. ./setup_wizard.py writes that file for you.
  //
  // This devcontainer.json is kept around for the (rare) case where someone
  // does want to use "Reopen in Container".
  "remoteUser": "devuser"
}
