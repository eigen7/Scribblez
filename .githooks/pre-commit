#!/bin/sh
# Guard: the vendored subtrees under subtrees/<dir>/ are READ-ONLY mirrors of an
# upstream repo. They may change only via `git subtree pull`, which records a
# merge commit -- and git does not run pre-commit on merges, so pulls are
# exempt. Any ordinary commit that stages changes under a subtree directory is
# rejected here, as early as git allows. Pure shell, so it has no dependencies
# and always runs. (Files directly under subtrees/, e.g. README.md, are
# parent-owned and allowed; only subtrees/<dir>/... is a subtree.)

offending=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^subtrees/[^/]+/')

if [ -n "$offending" ]; then
    echo "========================================================================" >&2
    echo "Your commit was blocked by the pre-commit hook (.githooks/pre-commit)." >&2
    echo "" >&2
    echo "Files under subtrees/<dir>/ are a READ-ONLY mirror of an upstream repo" >&2
    echo "and can't be committed directly:" >&2
    echo "$offending" | sed 's/^/    /' >&2
    echo "" >&2
    echo "To change a vendored subtree, edit its own upstream repo, then run:" >&2
    echo "    ./py/tools/pull_git_subtrees.py" >&2
    echo "" >&2
    echo "To unstage these (your file edits are kept):  git reset" >&2
    echo "To bypass for ONE commit (only if you are SURE): git commit --no-verify" >&2
    echo "========================================================================" >&2
    exit 1
fi
